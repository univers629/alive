# 必填：后台登录和所有上报客户端共用的密钥，至少 6 位，建议使用长随机字符串。
ALIVE_SECRET=change-me-at-least-6-characters
# 必填：首页展示名称。
ALIVE_PAGE_NAME=YourName

# 可选：Docker 对外端口，同时也是容器内 Alive 监听端口。省略时为 9010。
# ALIVE_PORT=9010
# 可选：Docker 宿主机上保存本地上传音乐的目录，容器内固定挂载为 /alive/music-library。
# 可填写绝对路径，例如 /srv/alive/music-library；省略时使用 ./data/music-library。
ALIVE_MUSIC_LIBRARY_HOST=./data/music-library

# 以下仅供仓库内旧版 Windows 上报脚本使用，Docker 服务与本地播放器插件不读取。
# ALIVE_SERVER=https://alive.example.com
# ALIVE_MUSIC_DIR=C:/Music
