ALIVE_SECRET=change-me-at-least-6-characters
ALIVE_PAGE_NAME=YourName
# 可选：远程 Alive 地址；省略时 Windows 上报器使用本机 http://127.0.0.1:9010。
# ALIVE_SERVER=https://alive.example.com
# Docker 宿主机上用于保存/读取本地音乐的目录，会挂载到容器 /alive/music-library。
ALIVE_MUSIC_LIBRARY_HOST=./data/music-library
# 仅供 Windows 音乐上报脚本扫描，可填写任意本机目录。
ALIVE_MUSIC_DIR=C:/Music
# 可选：网易云 Windows 客户端数据目录，默认会自动使用 LOCALAPPDATA。
# ALIVE_NETEASE_DIR=C:/Users/you/AppData/Local/NetEase/CloudMusic
